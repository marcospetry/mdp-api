# Copie para .env e preencha com as credenciais do ambiente.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:15432/mdp

# Gere uma chave longa e aleatoria para assinar JWTs.
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PREAUTH_TOKEN_MINUTES=5
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Chave Fernet para proteger o segredo TOTP no banco.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
MFA_ISSUER=MDP Consultoria

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTATO_DESTINO=
